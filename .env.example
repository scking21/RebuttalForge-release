# Sandbox only. The client refuses api-m.paypal.com.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Local stand-in for the sandbox: PAYPAL_BASE_URL=http://localhost:4010 (any id/secret)

# Explicit nvidia selection uses the existing NVIDIA provider; no automatic fallback.
# Leave AI_PROVIDER empty for backward-compatible Anthropic selection.
AI_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local review without an AI key: canned recommendations, labelled as a test double in the UI.
DISPUTE_DESK_TEST_DOUBLE=

# Required before exposing the server beyond this machine. Without it the server binds to 127.0.0.1 only.
# Use an operator token for credential-backed operation; loopback and CSRF checks are not authentication.
DISPUTE_DESK_OPERATOR_TOKEN=

PORT=4000
DATABASE_PATH=dispute-desk.sqlite
SELLER_RECORDS_DIR=fixtures/seller-records
